# OpenProject Docker Configuration
# Copia este archivo como .env y ajusta los valores

# IP y puerto de acceso
OPENPROJECT_HOST__NAME=192.168.0.59:8080
PORT=8080

# Desactivar HTTPS para red local
OPENPROJECT_HTTPS=false

# Secreto para sesiones (genera uno nuevo con: openssl rand -hex 64)
SECRET_KEY_BASE=changeme_genera_un_secreto_nuevo

# Base de datos
POSTGRES_DB=openproject
POSTGRES_USER=openproject
POSTGRES_PASSWORD=cambia_esta_contrasena
